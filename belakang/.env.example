# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env (sudah masuk .gitignore).

APP_NAME=Sekolah
APP_ENV=development
APP_URL=http://localhost:3000

APP_PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smpn254opencode
DB_USER=root
DB_PASS=ganti-dengan-password-mysql-anda

DB_TIMEZONE=Asia/Jakarta

# Minimal 32 karakter acak. Contoh membuat: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=7

MAX_LOGIN_ATTEMPT=5

UPLOAD_MAX_SIZE=5242880

DEFAULT_PASSWORD=GantiPassword123*
